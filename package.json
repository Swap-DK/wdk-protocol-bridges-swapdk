{
  "name": "wdk-protocol-bridges-swapdk",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for SwapDK WDK protocol bridge modules (EVM source, Solana source, shared common). Each package under packages/ publishes independently.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "test:ci": "vitest run --coverage --coverage.reporter=text --coverage.reporter=cobertura",
    "test:watch": "vitest",
    "clean": "npm run clean --workspaces --if-present",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Swap-DK/wdk-protocol-bridges-swapdk.git"
  },
  "author": "SwapDK",
  "bugs": {
    "url": "https://github.com/Swap-DK/wdk-protocol-bridges-swapdk/issues"
  },
  "homepage": "https://swapdk.com",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@vitest/coverage-v8": "^4.1.4",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  }
}
